#variables de entorno backend 
#el archivo .env nunca debe subirse a un repositorio publico
#por que contiene datos sencibles 
#pueto donde va correr el sevidor express
PORT=4000;

#datos conexion a mysql(XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventario_react

##texto secreto usado para firmar los token JWT de sesion
#cambiarlo por cualquier cadena larga y unica en su proyecto
JWT_SECRET=clave_secreta_curso_inventario_react
JWT_EXPIRES_IN=8h

#datos del usuario admin que crea npm run seed

SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_EMAIL=admin@inventario.com
SEED_ADMIN_PASSWORD=Admin123!